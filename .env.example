# Copie este arquivo para ".env" e preencha. O .env nunca vai para o git.

# GHL — Configurações > Integrações Privadas > Criar token da subconta
# Escopos necessários:
#   conversations.readonly, conversations/message.readonly,
#   contacts.readonly, contacts.write,
#   locations/customFields.readonly, locations/customFields.write
GHL_TOKEN=
GHL_LOCATION_ID=

# Postgres na nuvem (Supabase): Project Settings > Database > Connection string >
# aba "Session pooler" (funciona em qualquer rede, inclusive no GitHub). Troque [YOUR-PASSWORD]
# pela senha do banco. Deixe vazio para usar o SQLite local (dados.db), só para testes.
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Esforço de raciocínio (minimal/low/medium/high). Deixe vazio para modelos sem raciocínio.
OPENAI_REASONING_EFFORT=low

# Preço do modelo em US$ por 1M tokens (só para estimar o custo no fim da execução)
PRECO_ENTRADA_1M=0.25
PRECO_SAIDA_1M=2.00

# Quantas mensagens mais recentes de cada conversa mandar para a IA
MAX_MENSAGENS=30
# Mínimo de mensagens do lead para analisar. 0 = analisa também quem nunca respondeu
MIN_MENSAGENS_LEAD=0
# Conversas processadas em paralelo
PARALELO=4
# IDs de contatos internos (separados por vírgula) que não entram nas métricas
IGNORAR_CONTATOS=
# sim = grava campos 'IA - ...' e tags 'ia-' nos contatos do GHL. nao = só lê o GHL (só dashboard)
GRAVAR_NO_GHL=nao

# Planilha de agendamentos dos closers (Google Sheets): trecho do link entre /d/ e /edit
PLANILHA_ID=
# Arquivo .json da conta de serviço do Google (na pasta do projeto; não vai para o git)
GOOGLE_CREDENCIAIS=google-leitor.json
# Para testes sem Google: caminho de um .xlsx baixado da planilha
PLANILHA_ARQUIVO=
# Quantos contatos sem UTMs completar por rodada
CONTATOS_POR_RODADA=4000
